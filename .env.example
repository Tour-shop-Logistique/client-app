VITE_API_URL="https://your-api-host.example.com"
VITE_APP_VERSION="1.0.0"

# WebSocket (Laravel Reverb) - notifications temps reel (suivi colis, offres livreurs)
# Doit pointer sur le meme serveur Reverb que le backend VITE_API_URL.
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=ws.your-domain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
